# Ask the user to enter:

# Distance (km)

#fuel Efficiency (km/litre)

#Fuel Price per litre

#Hotel Cost

#Food Cost

#Calculate:

#Fuel Required

#Fuel Cost

#Total Trip Expense

#Display all results.

distance = int(input("Enter the km - "))
fuel_eff = int(input("Enter the mileage of your car/bike - "))
fuel_price = int(input("Enter the fuel cost per litre - "))
hotel_cost = int(input("Enter the hotel cost - "))
food_cost = int(input("Enter the food cost - "))

fuel_required = distance / fuel_eff

fuel_cost = fuel_required * fuel_price

total = fuel_cost + hotel_cost + food_cost

print(f"Fuel required =  , {fuel_required:.1f} (litre)")
print(f"Fuel cost =  , {fuel_cost:.1f}")
print(f"Total trip expenses =  , {total:.1f}")

