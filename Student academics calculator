#Question: Write a Python program to calculate a student's academic performance.
#Requirements
#Ask the student to enter marks for 5 subjects.
#
#Calculate:
#Total Marks
#Average Marks
#Percentage
#Display all the calculated values.
#Constraints
#Use variables, input(), print(), arithmetic operators, and type casting only. Do not use loops or conditional statement

marks1 = int(input("Enter your marks in subject 1 out of 100 - "))
marks2 = int(input("Enter your marks in subject 2 out of 100 - "))
marks3 = int(input("Enter your marks in subject 3 out of 100 - "))
marks4 = int(input("Enter your marks in subject 4 out of 100 - "))
marks5 = int(input("Enter your marks in subject 5 out of 100 - "))

total = marks1+marks2+marks3+marks4+marks5

average = total / 5

percentage = total / 500 * 100

print("Total marks - " , total)
print("Average marks - " , average)
print("Percentage - " , percentage ,"%")
 
 
